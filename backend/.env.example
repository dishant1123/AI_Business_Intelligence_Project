# Smart Manufacturing Intelligence Platform - Environment Variables

PROJECT_NAME="Smart Manufacturing Intelligence Platform"
PROJECT_VERSION="1.0.0"

# Application Security
SECRET_KEY=generate-a-secure-random-key-here-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL for Render, SQLite for local fallback)
DATABASE_URL=sqlite:///./manufacturing.db
# For Render PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Multi-Agent AI & LLM Provider ("gemini" or "openai")
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
# For Production:
# FRONTEND_URL=https://smart-manufacturing-ai.netlify.app

# Storage
REPORTS_DIR=./storage/reports
UPLOADS_DIR=./storage/uploads
ML_MODELS_DIR=./storage/models
